# ----- Runtime -----
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:5173

# ----- Database -----
# "sqlite" (development default, zero-config) or "supabase" (production)
DATABASE_TYPE=sqlite
# Path used when DATABASE_TYPE=sqlite
DATABASE_PATH=./data/xfind.db

# ----- Supabase (required when DATABASE_TYPE=supabase) -----
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ----- Auth -----
# "local" (development default) or "supabase"
AUTH_PROVIDER=local
# Required to sign local session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-in-production

# ----- Marketplace providers -----
MOCK_PROVIDER_ENABLED=true
# Vinted integration is intentionally a boundary. See docs/VINTED_INTEGRATION.md.
# No value here means the VintedProvider stays disabled and the app uses the mock provider.
VINTED_PROVIDER_ENABLED=false
VINTED_FEED_URL=

# ----- Web Push (optional) -----
# When absent, browser push is reported as "not configured" instead of faked.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ----- Ingestion -----
INGESTION_BATCH_SIZE=200
